# Local development only. On App Hosting these come from the platform and apphosting.yaml.
# Firebase console → Project settings → Your apps → Web app config, as one line of JSON:
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
# Service account key for firebase-admin (Project settings → Service accounts → Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-project-id
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
